{
  "name": "webgpu-local-llm",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/set-sw-version.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "audit:a11y": "node scripts/a11y-scan.mjs",
    "audit": "npm audit",
    "outdated": "npm outdated",
    "deploy": "scripts/deploy.sh"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/katex": "^0.16.8",
    "@wllama/wllama": "^3.8.1",
    "i18next": "^23.11.2",
    "katex": "^0.19.0",
    "prism-react-renderer": "^2.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.35",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
